# ============ CricLive configuration ============
PORT=3000
SESSION_SECRET=change-this-to-any-long-random-text

# ---- DATABASE ----
# sqlite = zero setup, database is a single file (recommended)
# mysql  = use your MySQL / XAMPP / WAMP server
DB_CLIENT=sqlite

# SQLite: where the database file is created
SQLITE_FILE=./database/criclive.db

# MySQL: fill these only if DB_CLIENT=mysql
# (the database itself is created automatically if it does not exist)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=criclive

# ---- SECURITY ----
# Set to true when the site runs on https (adds the Secure flag to the login cookie)
COOKIE_SECURE=false
# Check that a new player's e-mail domain really receives mail (DNS MX lookup)
EMAIL_MX_CHECK=true

# ---- E-MAIL for one-time sign-in codes (OTP) ----
# Leave SMTP_HOST empty = development mode: the code is shown on screen and in this terminal.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com
#                SMTP_PASS=<16-letter app password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CricLive <no-reply@criclive.local>
# true = show the code on screen in development mode (never shown once SMTP is set up)
OTP_SHOW_CODE=true
